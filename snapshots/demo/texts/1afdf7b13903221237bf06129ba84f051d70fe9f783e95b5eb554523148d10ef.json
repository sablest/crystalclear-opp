{"body":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"For an application based on ","underline":false},{"bold":false,"code":false,"color":"green","italic":false,"strikethrough":false,"text":"family reunification","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":", you need 1 bank statement","underline":false}],"type":"heading_2"},{"children":[{"children":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"(2*subsistence minimum*12 = 5500)","underline":false}],"type":"bulleted_list_item"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Ideally, the account should hold more than GEL 6,000 on the day you apply.","underline":false}],"type":"bulleted_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"The statement must be stamped and signed.","underline":false}],"type":"bulleted_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Such statements are not free: at Credo Bank, for example, one in Georgian costs GEL 10.","underline":false}],"type":"bulleted_list_item"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Statement of account balance","underline":false}],"type":"numbered_list_item"},{"children":[{"rich_text":[{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"In the balance statement for my wife's account","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":", we ","underline":false},{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"showed more than GEL 7,000","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":" when applying. ","underline":false}],"type":"bulleted_list_item"},{"children":[{"children":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"I came across a story where such an application was refused, and the couple had to open an account for the wife and move the money there.","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"At the Public Service Hall itself, the officer told me clearly that the account must be in the name of the person who is applying: if you apply for your wife through family reunification, the account must be in her name.","underline":false}],"type":"numbered_list_item"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"At first I planned to submit a statement for my own account (as the one who got the permit as an individual entrepreneur), because public sources said this was allowed. Then I changed my mind for 2 reasons:","underline":false}],"type":"bulleted_list_item"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"When applying for your wife's residence permit, ","underline":false},{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"the account must be in her name","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":".","underline":false}],"type":"bulleted_list_item"}],"icon":{"emoji":"💡"},"rich_text":[{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"My case (Dmitriy S.): statements from Credo Bank","underline":false}],"type":"callout"}],"lang":"en","title":"Bank statement for family reunification"}