{"body":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"What it looks like","underline":false}],"type":"heading_2"},{"rich_text":[{"bold":true,"code":false,"color":"green","italic":false,"strikethrough":false,"text":"The QR code on the certificate replaces the tax office stamp","underline":false}],"type":"paragraph"},{"caption":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"August 2024 version (","underline":false},{"bold":false,"code":false,"color":"yellow","italic":false,"strikethrough":false,"text":"the header on the left is different in the new version","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":")","underline":false}],"type":"image","url":"https://ozjgnsthtftrvayduioc.supabase.co/storage/v1/object/public/guide-assets/georgia-residence-permit/6f3e04521ba08f84e8aaf27e3763a452892f88af7e8d1c5d93245d9b9e8702f6.png"},{"type":"divider"},{"notion_type":"synced_block","type":"unsupported"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"How to get it","underline":false}],"type":"heading_2"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Log in to your Revenue Service account: ","underline":false},{"bold":false,"code":false,"color":"default","href":"https://eservices.rs.ge/Login.aspx","italic":false,"strikethrough":false,"text":"https://eservices.rs.ge/Login.aspx","underline":false}],"type":"numbered_list_item"},{"children":[{"children":[{"caption":[],"type":"image","url":"https://ozjgnsthtftrvayduioc.supabase.co/storage/v1/object/public/guide-assets/georgia-residence-permit/e4aa645331a18138463fb885c5aeeb938a4da038dfb21afc6b12aae1841d0b39.png"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Enter the periods, then choose the option you need"