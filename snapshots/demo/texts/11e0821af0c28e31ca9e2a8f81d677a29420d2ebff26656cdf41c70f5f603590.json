{"body":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"You can download the application form in advance here: ","underline":false},{"bold":false,"code":false,"color":"default","href":"https://sda.gov.ge/wp-content/uploads/2022/02/%E1%83%92%E1%83%90%E1%83%9C%E1%83%AA%E1%83%AE%E1%83%90%E1%83%93%E1%83%94%E1%83%91%E1%83%98%E1%83%A1_%E1%83%A4%E1%83%9D%E1%83%A0%E1%83%9B%E1%83%90_%E1%83%91%E1%83%98%E1%83%9C%E1%83%90%E1%83%93%E1%83%A0%E1%83%9D%E1%83%91%E1%83%98%E1%83%A1_%E1%83%9C%E1%83%94%E1%83%91%E1%83%90%E1%83%A0%E1%83%97%E1%83%95%E1%83%98%E1%83%A1_%E1%83%9B%E1%83%9D%E1%83%9E%E1%83%9D%E1%83%95%E1%83%94%E1%83%91%E1%83%98%E1%83%A1_%E1%83%A8%E1%83%94%E1%83%A1%E1%83%90%E1%83%AE%E1%83%94%E1%83%91-1.pdf","italic":false,"strikethrough":false,"text":"https://sda.gov.ge/wp-content/uploads/2022/02/განცხადების_ფორმა_ბინადრობის_ნებართვის_მოპოვების_შესახებ-1.pdf","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Then prepare at home and write down answers to all the obvious fields, so that filling in the form by hand at the Public Service Hall is easier and faster","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"For any field you are unsure about, ask the officer who accepts the documents.","underline":false}],"type":"numbered_list_item"},{"children":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"There is nothing difficult here; if questions come up, ask the officer who accepts applications.","underline":false}],"type":"paragraph"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Applying as an individual entrepreneur","underline":false}],"type":"heading_3"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"I didn't list any family members, because I have no family in Georgia","underline":false}],"type":"bulleted_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"We filled in almost the whole form in English, except for the following field","underline":false}],"type":"bulleted_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"gray","italic":true,"strikethrough":false,"text":"Documents supporting the grounds for the residence permit","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":" — I listed all my remaining documents in Russian","underline":false}],"type":"bulleted_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Applying for my wife through family reunification","underline":false}],"type":"heading_3"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"As the family member, we listed me (the husband)","underline":false}],"type":"bulleted_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"We filled in almost the whole form in English, except for the following field","underline":false}],"type":"bulleted_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"gray","italic":true,"strikethrough":false,"text":"Documents supporting the grounds for the residence permit","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":" — the officer told us we didn't need to write anything in this field, but we insisted and wrote that we were attaching the bank statement and the notarized copy of the marriage certificate. Update of ","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"2024-11-12","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":" — the permit was approved, with no questions about the form. ","underline":false}],"type":"bulleted_list_item"}],"icon":{"emoji":"💡"},"rich_text":[{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"My cases (Dmitriy S.)","underline":false}],"type":"callout"}],"lang":"en","title":"Residence permit application form"}