{"body":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Pour une demande au titre du ","underline":false},{"bold":false,"code":false,"color":"green","italic":false,"strikethrough":false,"text":"regroupement familial","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":", il faut 1 relevé bancaire","underline":false}],"type":"heading_2"},{"children":[{"children":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"(2*minimum vital*12 = 5500)","underline":false}],"type":"bulleted_list_item"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Idéalement, plus de 6 000 GEL sur le compte le jour de la demande.","underline":false}],"type":"bulleted_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Le relevé doit porter un cachet et une signature.","underline":false}],"type":"bulleted_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Ces relevés sont payants : chez Credo Bank, par exemple, un relevé en géorgien coûte 10 GEL.","underline":false}],"type":"bulleted_list_item"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Relevé de solde du compte (Statement of account balance)","underline":false}],"type":"numbered_list_item"},{"children":[{"rich_text":[{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Sur le relevé de solde du compte de ma femme","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":", nous avons ","underline":false},{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"montré plus de 7 000 GEL","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":" lors de la demande. ","underline":false}],"type":"bulleted_list_item"},{"children":[{"children":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"J'ai lu le cas d'une demande de ce type refusée : le couple a dû ouvrir un compte au nom de l'épouse et y transférer l'argent.","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"À la Maison de la Justice, l'agent m'a clairement dit que le compte doit être au nom de la personne qui fait la demande : si vous demandez un permis pour votre épouse au titre du regroupement familial, le compte doit être à son nom.","underline":false}],"type":"numbered_list_item"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Au départ, je prévoyais de fournir le relevé de mon propre compte (celui qui a obtenu le permis en tant qu'entrepreneur individuel), car des sources publiques disaient que c'était possible. J'ai changé d'avis pour 2 raisons :","underline":false}],"type":"bulleted_list_item"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Pour une demande de permis de séjour pour votre épouse, ","underline":false},{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"le compte doit être à son nom","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":".","underline":false}],"type":"bulleted_list_item"}],"icon":{"emoji":"💡"},"rich_text":[{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Mon cas (Dmitriy S.) : relevés de Credo Bank","underline":false}],"type":"callout"}],"lang":"fr","title":"Relevé bancaire pour le regroupement familial"}