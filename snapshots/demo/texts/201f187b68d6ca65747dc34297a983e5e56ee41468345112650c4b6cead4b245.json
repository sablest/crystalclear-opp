{"body":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"For an application as an individual entrepreneur, you need 2 bank statements","underline":false}],"type":"heading_2"},{"children":[{"children":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"(5*subsistence minimum*12 = about GEL 15,000; more is better)","underline":false}],"type":"bulleted_list_item"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Ideally, the account should hold more than GEL 17,000 on the day you apply.","underline":false}],"type":"bulleted_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"The statement must be stamped and signed.","underline":false}],"type":"bulleted_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Such statements are not free: at Credo Bank, for example, one in Georgian costs GEL 10.","underline":false}],"type":"bulleted_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"With TBC Concept, this statement is free.","underline":false}],"type":"bulleted_list_item"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Statement of account balance","underline":false}],"type":"numbered_list_item"},{"children":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Usually dozens of pages, depending on the number of transactions","underline":false}],"type":"bulleted_list_item"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Statement of account transactions for the year (Statement of the movement of funds on the account for the year)","underline":false}],"type":"numbered_list_item"},{"type":"divider"},{"children":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"I have no separate business account = no client payments into a bank account","underline":false}],"type":"bulleted_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"I received client payments in crypto (USDT) and exchanged them for cash, part of which I deposited into my bank accounts","underline":false}],"type":"bulleted_list_item"},{"children":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"I noticed that since October 2024 Credo Bank balance statements can cover several accounts, whereas in August 2024 they could only cover one.","underline":false}],"type":"bulleted_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"A statement in Georgian costs GEL 10 (","underline":false},{"bold":false,"code":false,"color":"gray","italic":true,"strikethrough":false,"text":"in English it's GEL 20, just for reference","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":") ","underline":false}],"type":"bulleted_list_item"}],"rich_text":[{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"In the balance statement","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":", I ","underline":false},{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"showed more than GEL 19,000","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":" when applying. ","underline":false}],"type":"bulleted_list_item"},{"children":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Mine was about ~60 pages. ","underline":false}],"type":"bulleted_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"The bank printed it for free.","underline":false}],"type":"bulleted_list_item"}],"rich_text":[{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"In the transactions statement","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":" (my main personal account), I showed the same period as in the tax certificates, i.e. the last 12 months. ","underline":false}],"type":"bulleted_list_item"},{"type":"divider"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"So at the Public Service Hall they look at ","underline":false},{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"how much money is in the account","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":" and how you use your bank card in Georgia (perhaps also whether and how long you have lived here — but that is only my guess). ","underline":false}],"type":"paragraph"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"They don't look at the business activity itself: no invoices or contracts were requested, only the tax certificates.","underline":false}],"type":"paragraph"}],"icon":{"emoji":"💡"},"rich_text":[{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"My case (Dmitriy S.): statements from Credo Bank","underline":false}],"type":"callout"}],"lang":"en","title":"Bank statements for the individual entrepreneur path"}