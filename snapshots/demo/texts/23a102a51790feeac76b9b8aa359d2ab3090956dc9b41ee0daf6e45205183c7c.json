{"body":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"The residence permit photo is taken at the Public Service Hall, before you submit your application and documents:","underline":false}],"type":"heading_3"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Find the photo booths and the staff next to them","underline":false}],"type":"bulleted_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Say that you need a photo for a residence permit","underline":false}],"type":"bulleted_list_item"},{"children":[{"children":[{"caption":[],"type":"image","url":"https://ozjgnsthtftrvayduioc.supabase.co/storage/v1/object/public/guide-assets/georgia-residence-permit/8d78c48143e40acd508c8c34ee809f0be5f751b7f84bca799a6c788c8b5c83e9.png"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"This is what the barcode looks like (double-click ↓)","underline":false}],"type":"bulleted_list_item"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Once the photo is taken, you get a barcode that you hand in together with all your documents","underline":false}],"type":"bulleted_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Using the barcode, the officer uploads your photo to the system, and the same photo is printed on your ID card (binadroba).","underline":false}],"type":"bulleted_list_item"},{"rich_text":[],"type":"paragraph"}],"lang":"en","title":"Photo"}