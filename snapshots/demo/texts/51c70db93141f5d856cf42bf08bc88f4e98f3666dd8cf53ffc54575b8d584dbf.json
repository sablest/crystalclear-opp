{"body":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"What it looks like","underline":false}],"type":"heading_2"},{"rich_text":[{"bold":true,"code":false,"color":"green","italic":false,"strikethrough":false,"text":"The QR code on the certificate replaces the tax office stamp","underline":false}],"type":"paragraph"},{"caption":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"August 2024 version (","underline":false},{"bold":false,"code":false,"color":"yellow","italic":false,"strikethrough":false,"text":"the header on the left is different in the new version","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":")","underline":false}],"type":"image","url":"https://ozjgnsthtftrvayduioc.supabase.co/storage/v1/object/public/guide-assets/georgia-residence-permit/81a708285026aaca2ef7f52867abf4b111cd6216a631fc6ea6cbd436c1898404.png"},{"type":"divider"},{"notion_type":"synced_block","type":"unsupported"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"How to get it","underline":false}],"type":"heading_2"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Log in to your Revenue Service account: ","underline":false},{"bold":false,"code":false,"color":"default","href":"https://eservices.rs.ge/Login.aspx","italic":false,"strikethrough":false,"text":"https://eservices.rs.ge/Login.aspx","underline":false}],"type":"numbered_list_item"},{"children":[{"caption":[],"type":"image","url":"https://ozjgnsthtftrvayduioc.supabase.co/storage/v1/object/public/guide-assets/georgia-residence-permit/f4f9e440122376c8ce9f7b4665326976a8f97eaad81dea3d1dc460cae6b3c9ca.png"},{"type":"divider"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Open the request page: ","underline":false},{