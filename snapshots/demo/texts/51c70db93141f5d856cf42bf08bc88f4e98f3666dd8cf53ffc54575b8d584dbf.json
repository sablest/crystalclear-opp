lse,"color":"default","italic":false,"strikethrough":false,"text":"Or","underline":true},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":" open your email and download the document from the message (example ↓) ","underline":false},{"bold":true,"code":false,"color":"orange","italic":false,"strikethrough":false,"text":"(you can also download it via the link in the SMS)","underline":false}],"type":"numbered_list_item"},{"type":"divider"}],"rich_text":[{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"To download it:","underline":false}],"type":"numbered_list_item"}],"lang":"en","title":"Certificate of taxes paid in the last 12 months"}