{"body":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"What it looks like","underline":false}],"type":"heading_2"},{"rich_text":[{"bold":true,"code":false,"color":"green","italic":false,"strikethrough":false,"text":"The QR code on the certificate replaces the tax office stamp","underline":false}],"type":"paragraph"},{"children":[{"children":[{"caption":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"August 2024 version","underline":false}],"type":"image","url":"https://ozjgnsthtftrvayduioc.supabase.co/storage/v1/object/public/guide-assets/georgia-residence-permit/68661510aab90283a31a2acc1ddd8066b9b7b9351d7fb5c411cba3edb3779f0f.png"}],"type":"column"},{"children":[{"caption":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"October 2024 version (","underline":false},{"bold":false,"code":false,"color":"red","italic":false,"strikethrough":false,"text":"the header on the left changed","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":")","underline":false}],"type":"image","url":"https://ozjgnsthtftrvayduioc.supabase.co/storage/v1/object/public/guide-assets/georgia-residence-permit/18e980023df1a6258de20a8d906471f59ccff7417cf2d49dd0fb7d760d245691.png"}],"type":"column"}],"type":"column_list"},{"rich_text":[],"type":"paragraph"},{"type":"divider"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"How to get it","underline":false}],"type":"heading_2"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Log in to your Revenue Service account: ","underline":false},{"bold":false,"code":false,"color":"default","href":"https://eservices.rs.ge/Login.aspx","italic":false,"strikethrough":false,"text":"https://eservices.rs.ge/Login.aspx","underline":false}],"type":"numbered_list_ite