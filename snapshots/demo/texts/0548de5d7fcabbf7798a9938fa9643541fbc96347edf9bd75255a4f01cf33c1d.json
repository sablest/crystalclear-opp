false,"strikethrough":false,"text":" → find your request by its ID and download it (example ↓)","underline":false}],"type":"numbered_list_item"},{"children":[{"caption":[],"type":"image","url":"https://ozjgnsthtftrvayduioc.supabase.co/storage/v1/object/public/guide-assets/georgia-residence-permit/d442db0155172d0d849fa8d22c36079c47ad6162cc09b5a5b2313b69cb5da4f5.png"}],"rich_text":[{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Or","underline":true},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":" open your email and download the document from the message (example ↓) ","underline":false},{"bold":true,"code":false,"color":"orange","italic":false,"strikethrough":false,"text":"(you can also download it via the link in the SMS)","underline":false}],"type":"numbered_list_item"},{"type":"divider"}],"rich_text":[{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"To download it:","underline":false}],"type":"numbered_list_item"},{"rich_text":[],"type":"paragraph"}],"lang":"en","title":"Certificate of no outstanding debts"}