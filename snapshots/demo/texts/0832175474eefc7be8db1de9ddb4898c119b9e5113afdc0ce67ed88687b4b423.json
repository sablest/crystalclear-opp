{"body":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"What it looks like","underline":false}],"type":"heading_2"},{"rich_text":[{"bold":true,"code":false,"color":"green","italic":false,"strikethrough":false,"text":"The QR code on the certificate replaces the tax office stamp","underline":false}],"type":"paragraph"},{"children":[{"children":[{"caption":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"August 2024 version","underline":false}],"type":"image","url":"https://ozjgnsthtftrvayduioc.supabase.co/storage/v1/object/public/guide-assets/georgia-residence-permit/d9dbd3f6ab8034f53f8688799c9638a84491cf28d646bec7ba0f5d6736e2c767.png"}],"type":"column"},{"children":[{"caption":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"October 2024 version (","underline":false},{"bold":false,"code":false,"color":"red","italic":false,"strikethrough":false,"text":"the header on the left changed","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":")","underline":false}],"type":"image","url":"https://ozjgnsthtftrvayduioc.supabase.co/storage/v1/object/public/guide-assets/georgia-residence-permit/b821325dbdc78e3d6d40c158427bb9b21b24e1f5e673c42ba07d1621b4d36db8.png"}],"type":"column"}],"type":"column_list"},{"type":"divider"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"How to get it","underline":false}],"type":"heading_2"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Log in to your Revenue Service account: ","underline":false},{"bold":false,"code":false,"color":"default","href":"https://eservices.rs.ge/Login.aspx","italic":false,"strikethrough":false,"text":"https://eservices.rs.ge/Login.aspx","underline":false}],"type":"numbered_list_item"},{"children":[{"caption":[],"type":"image","url":"https://ozjgnsthtftrvayduioc.supabase.co/storage/v1/object/public/guide-assets/georgia-residence-permit/4b3440418e89a47d761a7ae5ecdc6faadedb9f0fe98ef389a85bc6403b7681a2.png"},{"type":"divider"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Open the request page: ","underline":false},{"bold":false,"code":false,"color":"default","href":"https://eservices.rs.ge/ServiceRequestNew.aspx?p=23","italic":false,"strikethrough":false,"text":"https://eservices.rs.ge/ServiceRequestNew.aspx?p=23","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":" and submit a new request","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"After submitting, you will immediately see your registered request and receive an SMS and an email → save the request ID so you can find the document later.","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"When the certificate is ready, you will receive an SMS and an email. It usually takes about 2 minutes.","underline":false}],"type":"numbered_list_item"},{"children":[{"children":[{"caption":[],"type":"image","url":"https://ozjgnsthtftrvayduioc.supabase.co/storage/v1/object/public/guide-assets/georgia-residence-permit/bcd6c1b297ae4b227266bc763b9e4f2274e6fffad1e34c4e0cfe5be6bd9c79a2.png"},{"type":"divider"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Open ","underline":false},{"bold":false,"code":false,"color":"default","href":"https://eservices.rs.ge/ServiceRequests.aspx","italic":false,"strikethrough":false,"text":"https://eservices.rs.ge/ServiceRequests.aspx","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":" → find your request by its ID and download it","underline":false}],"type":"numbered_list_item"},{"children":[{"caption":[],"type":"image","url":"https://ozjgnsthtftrvayduioc.supabase.co/storage/v1/object/public/guide-assets/georgia-residence-permit/d442db0155172d0d849fa8d22c36079c47ad6162cc09b5a5b2313b69cb5da4f5.png"}],"rich_text":[{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Or","underline":true},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":" open your email and download the document from the message (example ↓) ","underline":false},{"bold":true,"code":false,"color":"orange","italic":false,"strikethrough":false,"text":"(you can also download it via the link in the SMS)","underline":false}],"type":"numbered_list_item"},{"type":"divider"}],"rich_text":[{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"To download it:","underline":false}],"type":"numbered_list_item"}],"lang":"en","title":"VAT payment certificate"}