{"body":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Your application is approved — congratulations! ","underline":false}],"type":"paragraph"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Two steps are left: order your binadroba and collect it when it's ready.","underline":false}],"type":"paragraph"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Visit the Public Service Hall to order your binadroba (residence ID card)","underline":false}],"type":"heading_2"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Bring your passport and the document you received when you applied (the one with the barcode and your application details);","underline":false}],"type":"numbered_list_item"},{"children":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"The person registering you must bring their piradoba (Georgian ID card).","underline":false}],"type":"bulleted_list_item"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Go to the Public Service Hall with your landlord, who will temporarily register you at your address — it's free for the owner. This is the only time you need your landlord's help.","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"At the Public Service Hall, take a queue ticket and say that your residence permit has been approved.","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Tell the officer you need a binadroba and hand over your passport and the barcode document.","underline":false}],"type":"numbered_list_item"},{"children":[{"children":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"According to the binadroba brochure (October 2024), prices by turnaround time are:","underline":false}],"type":"paragraph"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"10 days — GEL 60","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"5 days — GEL 80","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"3 days — GEL 100","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"1 day — GEL 120","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Same day — GEL 150","underline":false}],"type":"numbered_list_item"}],"icon":{"emoji":"💡"},"rich_text":[{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"I chose 10 days for GEL 60.","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":" ","underline":false}],"type":"callout"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"The officer will then ask your landlord for their ID (piradoba) and, based on the temporary registration, order your binadroba — you just choose how fast you want it.","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"You pay for the option you chose and receive a document — you'll need it to collect your finished residence card.","underline":false}],"type":"numbered_list_item"}],"lang":"en","title":"How to order your binadroba (residence ID card)"}