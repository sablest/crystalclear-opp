{"body":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"What the certificate looks like","underline":false}],"type":"heading_2"},{"caption":[],"type":"image","url":"https://ozjgnsthtftrvayduioc.supabase.co/storage/v1/object/public/guide-assets/georgia-residence-permit/a6f377631a48c2e3f70e211054e2c0faf0d076fa32fcd37afa46f3b3b56fd118.png"},{"type":"divider"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Where to find (download) the certificate if you don't have it at hand","underline":false}],"type":"heading_2"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Log in to your Revenue Service account: ","underline":false},{"bold":false,"code":false,"color":"default","href":"https://eservices.rs.ge/Login.aspx","italic":false,"strikethrough":false,"text":"https://eservices.rs.ge/Login.aspx","underline":false}],"type":"numbered_list_item"},{"children":[{"caption":[],"type":"image","url":"https://ozjgnsthtftrvayduioc.supabase.co/storage/v1/object/public/guide-assets/georgia-residence-permit/6e0539c7076d5317efca2e4d2183ed700c6211a416393c2453535cc617c08585.png"},{"type":"divider"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Open the request page: ","underline":false},{"bold":false,"code":false,"color":"default","href":"https://eservices.rs.ge/ServiceRequestNew.aspx?p=573","italic":false,"strikethrough":false,"text":"https://eservices.rs.ge/ServiceRequestNew.aspx?p=573","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":" and submit a new request","underline":false}],"type":"numbered_list_item"},{"children":[{"caption":[],"type":"image","url":"https://ozjgnsthtftrvayduioc.supabase.co/storage/v1/object/public/guide-assets/georgia-residence-permit/43caaa8d59d92f168b5f333ba1b252ad4cbf00f159903997e8