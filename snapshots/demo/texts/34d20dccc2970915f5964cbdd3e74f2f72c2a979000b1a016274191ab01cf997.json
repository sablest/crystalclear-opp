,"text":"(you can also download it via the link in the SMS)","underline":false}],"type":"numbered_list_item"},{"type":"divider"}],"rich_text":[{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"To download it:","underline":false}],"type":"numbered_list_item"}],"lang":"en","title":"Small business status certificate"}