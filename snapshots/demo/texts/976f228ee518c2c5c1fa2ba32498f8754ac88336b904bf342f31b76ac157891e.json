{"body":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Как выглядит","underline":false}],"type":"heading_2"},{"rich_text":[{"bold":true,"code":false,"color":"green","italic":false,"strikethrough":false,"text":"QR-код на справке заменяет печать налоговой","underline":false}],"type":"paragraph"},{"caption":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Версия от августа 2024 (","underline":false},{"bold":false,"code":false,"color":"yellow","italic":false,"strikethrough":false,"text":"в новой версии шапка слева будет другой","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":")","underline":false}],"type":"image","url":"https://ozjgnsthtftrvayduioc.supabase.co/storage/v1/object/public/guide-assets/georgia-residence-permit/81a708285026aaca2ef7f52867abf4b111cd6216a631fc6ea6cbd436c1898404.png"},{"type":"divider"},{"notion_type":"synced_block","type":"unsupported"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Как получить","underline":false}],"type":"heading_2"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Авторизоваться в личном кабинете налоговой: ","underline":false},{"bold":false,"code":false,"color":"default","href":"https://eservices.rs.ge/Login.aspx","italic":false,"strikethrough":false,"text":"https://eservices.rs.ge/Login.aspx","underline":false}],"type":"numbered_list_item"},{"children":[{"caption":[],"type":"image","url":"https://ozjgnsthtftrvayduioc.supabase.co/storage/v1/object/public/guide-assets/georgia-residence-permit/f4f9e440122376c8ce9f7b4665326976a8f97eaad81dea3d1dc460cae6b3c9ca.png"},{"type":"divider"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Открыть страницу заявления: ","underline":false},{"bold":false,"code":false,"