"color":"default","italic":false,"strikethrough":false,"text":"Или","underline":true},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":" откройте ваш email и в полученных письмах скачайте документ (пример ↓) ","underline":false},{"bold":true,"code":false,"color":"orange","italic":false,"strikethrough":false,"text":"(также документ можно скачать через ссылку, полученную в СМС)","underline":false}],"type":"numbered_list_item"},{"type":"divider"}],"rich_text":[{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Чтобы скачать:","underline":false}],"type":"numbered_list_item"}],"lang":"fr","title":"Certificate of taxes paid in the last 12 months"}