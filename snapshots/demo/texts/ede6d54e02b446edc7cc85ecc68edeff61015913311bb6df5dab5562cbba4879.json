{"body":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Votre demande est approuvée : félicitations ! ","underline":false}],"type":"paragraph"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Il reste 2 étapes : commander votre binadroba et la récupérer quand elle est prête.","underline":false}],"type":"paragraph"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Se rendre à la Maison de la Justice pour commander votre binadroba (carte de résident)","underline":false}],"type":"heading_2"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Apportez votre passeport et le document reçu lors de la demande (avec le code-barres et les données de votre demande) ;","underline":false}],"type":"numbered_list_item"},{"children":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"La personne qui vous domicilie doit apporter sa piradoba (carte d'identité géorgienne).","underline":false}],"type":"bulleted_list_item"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Allez à la Maison de la Justice avec votre propriétaire, qui vous domiciliera temporairement à votre adresse (gratuit pour lui). C'est la seule fois où vous aurez besoin de l'aide de votre propriétaire.","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"À la Maison de la Justice, prenez un ticket et indiquez que votre permis de séjour a été approuvé.","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Dites à l'agent que vous avez besoin d'une binadroba et remettez votre passeport et le document avec le code-barres.","underline":false}],"type":"numbered_list_item"},{"children":[{"children":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Selon la brochure sur la binadroba (octobre 2024), les tarifs selon le délai sont :","underline":false}],"type":"paragraph"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"10 jours — 60 GEL","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"5 jours — 80 GEL","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"3 jours — 100 GEL","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"1 jour — 120 GEL","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Le jour même — 150 GEL","underline":false}],"type":"numbered_list_item"}],"icon":{"emoji":"💡"},"rich_text":[{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"J'ai choisi 10 jours pour 60 GEL.","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":" ","underline":false}],"type":"callout"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"L'agent demandera ensuite la pièce d'identité (piradoba) de votre propriétaire et, sur la base de la domiciliation temporaire, lancera la fabrication de votre binadroba ; il vous reste à choisir le délai.","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Vous payez l'option choisie et recevez un document : il vous servira à récupérer votre carte de résident.","underline":false}],"type":"numbered_list_item"}],"lang":"fr","title":"Commander votre binadroba (carte de résident)"}