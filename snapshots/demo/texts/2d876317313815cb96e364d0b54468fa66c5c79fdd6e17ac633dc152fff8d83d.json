{"body":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Для подачи на основании ","underline":false},{"bold":false,"code":false,"color":"green","italic":false,"strikethrough":false,"text":"воссоединения семьи","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":" нужно получить 1 выписку из банка","underline":false}],"type":"heading_2"},{"children":[{"children":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"(2*минимальный прожиточный минимум*12 = 5500)","underline":false}],"type":"bulleted_list_item"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Желательно, чтобы было больше 6 000 GEL на момент подачи заявления на ВНЖ.","underline":false}],"type":"bulleted_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Справка должна быть с печатью и подписью.","underline":false}],"type":"bulleted_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Такие справки платные, например в Credo Bank стоит 10 GEL на грузинском языке.","underline":false}],"type":"bulleted_list_item"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Выписка об остатках на счете (Statement of account balance)","underline":false}],"type":"numbered_list_item"},{"children":[{"rich_text":[{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"В выписке об остатке на счет жены","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":" при подаче заявления мы ","underline":false},{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"показали больше 7 000 GEL","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":". ","underline":false}],"type":"bulleted_list_item"},{"children":[{"children":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Увидел историю, что при такой подаче получили отказ и пришлось открывать счет жене и переводить деньги на счет жены.","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"В самом Доме Юстиции я уточнил у специалиста и мне однозначно сказали, что счет должен быть на имя человека, заявление от которого вы подаете = раз вы подаете на ВНЖ по воссоединению жены, то и счет должен быть на её имя.","underline":false}],"type":"numbered_list_item"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Изначально планировал подать выписку из банка своего счета (тот, кто получил ВНЖ по ИП) — потому что в открытых источниках была информация, что так можно. Затем передумал по 2 причинам:","underline":false}],"type":"bulleted_list_item"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"В случае подачи заявления на ВНЖ для жены, ","underline":false},{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"нужно, чтобы счет был на имя жены","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":".","underline":false}],"type":"bulleted_list_item"}],"icon":{"emoji":"💡"},"rich_text":[{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Мой кейс (Дмитрий С.) — выписки из Credo Bank","underline":false}],"type":"callout"}],"lang":"ru","title":"Выписка из банка по воссоединению"}