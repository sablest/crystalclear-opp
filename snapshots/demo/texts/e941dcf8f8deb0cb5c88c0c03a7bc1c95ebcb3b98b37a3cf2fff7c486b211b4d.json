{"body":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Вы получили одобрение — поздравляю! ","underline":false}],"type":"paragraph"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Осталось 2 шага: заказать бинадробу и забрать по готовности.","underline":false}],"type":"paragraph"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Посетить Дом Юстиции, чтобы заказать бинадробу (ID-карту)","underline":false}],"type":"heading_2"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Взять с собой загранпаспорт и документ, полученный при подаче заявления (в котором есть штрих-код и данные вашего заявления);","underline":false}],"type":"numbered_list_item"},{"children":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Тот, кто будет вас регистрировать, должен взять с собой пирадобу (ID-карту).","underline":false}],"type":"bulleted_list_item"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Посетить Дом Юстиции с хозяином квартиры, который временно зарегистрирует вас по месту жительства — для владельца жилья это бесплатно. Это единственный раз, когда вам нужна помощь от владельца квартиры, где вы живете.","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"В Доме Юстиции возьмите талон — скажите, что получили одобрение на ВНЖ.","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Сообщите специалисту, что вам нужна бинадроба и предоставьте паспорт с документом со штрих-кодом.","underline":false}],"type":"numbered_list_item"},{"children":[{"children":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"В брошюре о бинадробе на октябрь 2024 года цены по скорости изготовления такие:","underline":false}],"type":"paragraph"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"10 дней — 60 лари","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"5 дней — 80 лари","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"3 дня — 100 лари","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"1 день — 120 лари","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"День в день — 150 лари","underline":false}],"type":"numbered_list_item"}],"icon":{"emoji":"💡"},"rich_text":[{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Я выбирал 10 дней за 60 лари.","underline":false},{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":" ","underline":false}],"type":"callout"}],"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Далее специалист попросит у хозяина квартиры его удостоверение личности (пирадоба) и на основании временной регистрации, оформит выпуск вашей бинадробы — вам останется выбрать скорость изготовления.","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Вы оплатите выбранный вариант и получите документ — с ним нужно будет забрать готовку карточку ВНЖ.","underline":false}],"type":"numbered_list_item"}],"lang":"en","title":"How to order your binadroba (residence ID card)"}