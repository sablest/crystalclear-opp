{"body":[{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"The key requirements I relied on, from public sources","underline":false}],"type":"heading_2"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Live in Georgia for at least 6 months","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Your husband, wife or parent holds a residence permit card","underline":false}],"type":"numbered_list_item"},{"rich_text":[{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"text":"Proof of the family relationship, e.g. a birth or marriage certificate.","underline":false}],"type":"numbered_list_item"}],"lang":"en","title":"Prerequisites: applying through family reunification"}